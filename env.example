# Copy to `env` (git-ignored) and fill in. None of these values are secret,
# but they identify your Okta org, so keep `env` out of version control.
OKTA_ORG_URL="https://your-org.okta.com"   # no "-admin" in the hostname
OKTA_CLIENT_ID="your-client-id"
OKTA_KEY_ID="your-key-id"

# 1Password secret reference to the PEM private key (e.g. a Secure Note's body).
OKTA_PRIVATE_KEY_REF="op://dev/Okta access review key/notesPlain"

# Space-separated. Read scopes only: the tool refuses to start with anything else.
OKTA_SCOPES="okta.users.read okta.groups.read okta.apps.read okta.appGrants.read okta.roles.read"

# Bind access tokens to a per-run key (DPoP). Must match "Require DPoP" on the app.
OKTA_DPOP="true"
